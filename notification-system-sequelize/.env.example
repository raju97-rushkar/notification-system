# 3002, so it can run next to the MongoDB project (3000) and the raw-SQL project (3001)
PORT=3002

# Local PostgreSQL 17 on port 5433 (5432 is used by a Docker container on this PC).
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# The database and tables are created automatically on first start.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/notification_system_sequelize

# ---- Worker ----
# true = worker runs inside the API process. false = run it separately: npm run worker
RUN_WORKER=true
# node-cron format (with seconds): every 5 seconds
WORKER_SCHEDULE=*/5 * * * * *
WORKER_BATCH_SIZE=50
WORKER_LOCK_TIME_MS=60000
MAX_ATTEMPTS=3
RETRY_DELAY_MS=30000
# Demo only: 0.3 = 30% of attempts fail on purpose
SIMULATED_FAILURE_RATE=0
